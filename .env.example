# Tiny Tank MCP runtime settings. No secrets belong in this file.
# Interface to bind. Use 0.0.0.0 inside a container.
MCP_HOST=127.0.0.1
# Port to listen on.
MCP_PORT=8000
# Comma-separated Host header allowlist (DNS-rebinding protection). Example: tinytank.example.com,tinytank.example.com:*
MCP_ALLOWED_HOSTS=
# Comma-separated Origin allowlist. Example: https://tinytank.example.com
MCP_ALLOWED_ORIGINS=
